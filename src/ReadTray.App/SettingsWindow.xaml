<Window x:Class="ReadTray.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReadTray Settings" Width="560" Height="560" WindowStartupLocation="CenterScreen"
        Background="#F6F7F9">
    <ScrollViewer>
        <StackPanel Margin="24">
            <TextBlock Text="ReadTray Settings" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>
            <TextBlock Text="Provider"/>
            <ComboBox x:Name="ProviderBox" DisplayMemberPath="DisplayName" SelectedValuePath="Id" Margin="0,4,0,14" SelectionChanged="ProviderBox_SelectionChanged"/>
            <TextBlock Text="Voice"/>
            <ComboBox x:Name="VoiceBox" DisplayMemberPath="DisplayName" SelectedValuePath="Id" Margin="0,4,0,14"/>
            <TextBlock Text="ElevenLabs custom voice ID"/>
            <TextBox x:Name="ElevenLabsCustomVoiceBox" Margin="0,4,0,4"/>
            <TextBlock Text="If set, this voice ID is used instead of the selected voice list entry." TextWrapping="Wrap" Foreground="#5D6470" FontSize="12" Margin="0,0,0,14"/>
            <TextBlock Text="Speed"/>
            <Slider x:Name="SpeedSlider" Minimum="0.6" Maximum="1.8" TickFrequency="0.1" Margin="0,4,0,14"/>
            <CheckBox x:Name="PrivacyModeBox" Content="Privacy mode: use local Windows TTS only" Margin="0,0,0,14"/>
            <CheckBox x:Name="DebugLoggingBox" Content="Enable debug logging to file" Margin="0,0,0,8"/>
            <CheckBox x:Name="DebugTextPreviewBox" Content="Include short captured-text preview in debug logs" Margin="20,0,0,14"/>
            <TextBlock Text="Debug logging level is applied on the next app restart. API keys are never written to logs." TextWrapping="Wrap" Foreground="#5D6470" FontSize="12" Margin="0,0,0,14"/>
            <TextBlock Text="ElevenLabs API key"/>
            <PasswordBox x:Name="ElevenLabsKeyBox" Margin="0,4,0,14"/>
            <TextBlock Text="ElevenLabs model"/>
            <TextBox x:Name="ElevenLabsModelBox" Margin="0,4,0,14"/>
            <CheckBox x:Name="RestoreClipboardBox" Content="Restore previous clipboard text after selected-text capture" Margin="0,0,0,14"/>
            <CheckBox x:Name="AutoHideBox" Content="Auto-hide player after playback" Margin="0,0,0,18"/>
            <CheckBox x:Name="DuckAudioBox" Content="Lower other computer audio while ReadTray is speaking" Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Other audio volume" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Slider x:Name="DuckAudioVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"/>
                <TextBlock x:Name="DuckAudioVolumeText" Grid.Column="2" Width="48" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <CheckBox x:Name="CheckForUpdatesBox" Content="Check for updates on startup" Margin="0,0,0,18"/>
            <TextBlock Text="Hotkeys: Ctrl+Shift+F12 reads selection. Ctrl+Alt+Shift+Space reads clipboard. Custom hotkey editing is stored in settings.json for this MVP." TextWrapping="Wrap" Foreground="#5D6470" Margin="0,0,0,18"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Save" Width="96" Height="34" Click="Save_Click"/>
                <Button Content="Refresh voices" Width="120" Height="34" Margin="10,0,0,0" Click="RefreshVoices_Click"/>
                <Button Content="Close" Width="96" Height="34" Margin="10,0,0,0" Click="Close_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
