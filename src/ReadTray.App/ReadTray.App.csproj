<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <None Include="Assets\ReadTray.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\ReadTray.png" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\ReadTray.Core\ReadTray.Core.csproj" />
    <ProjectReference Include="..\ReadTray.Infrastructure\ReadTray.Infrastructure.csproj" />
    <ProjectReference Include="..\ReadTray.Tts.ElevenLabs\ReadTray.Tts.ElevenLabs.csproj" />
    <ProjectReference Include="..\ReadTray.Tts.Windows\ReadTray.Tts.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.8" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\ReadTray.ico</ApplicationIcon>
    <StartupObject>ReadTray.App.Program</StartupObject>
    <VersionPrefix>0.1.0</VersionPrefix>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
  </PropertyGroup>

</Project>
